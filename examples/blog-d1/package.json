{
  "name": "@comp/example-blog-d1",
  "version": "0.0.0",
  "private": true,
  "description": "Reference Comp app: Cloudflare D1 + Drizzle",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "tsc -p tsconfig.json --noEmit",
