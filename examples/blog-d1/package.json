    "@comp/auth": "workspace:*",
    "@comp/core": "workspace:*",
    "@comp/server": "workspace:*",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241218.0",
    "drizzle-kit": "^0.30.1",
    "wrangler": "^3.99.0"
  }
}
