{
  "name": "@comp/cli",
  "version": "0.0.0",
  "description": "Scaffolding, codegen, and deploy helpers for Comp",
  "license": "MIT",
  "type": "module",
  "bin": {
    "comp": "./src/bin.ts"
  },
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": ["dist"],
  "publishConfig": {
    "bin": {
      "comp": "./dist/bin.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@comp/core": "workspace:*"
  },
  "devDependencies": {
    "drizzle-orm": "^0.44.2"
  }
}
