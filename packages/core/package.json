{
  "name": "@comp/core",
  "version": "0.0.0",
  "description": "Schema introspection, defineCollection, and the query layer for Comp",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "tsc -p tsconfig.json"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.36.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "drizzle-orm": "^0.44.2",
    "zod": "^3.24.1"
  }
}
